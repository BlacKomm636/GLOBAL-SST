# ---- Server ----
SERVER_PORT=8080

# ---- Database (Supabase PostgreSQL) ----
DB_URL=jdbc:postgresql://<supabase-host>:5432/postgres
DB_USERNAME=postgres
DB_PASSWORD=

# ---- JWT ----
JWT_SECRET=change-me-to-a-long-random-base64-secret
JWT_EXPIRATION_MS=3600000

# ---- CORS ----
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- Supabase Storage ----
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=certificates

# ---- Public verification base URL (used to build the QR target) ----
PUBLIC_VERIFY_BASE_URL=http://localhost:5173/verify

# ---- Resend (email) ----
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@yourdomain.com

# ---- Default admin bootstrap (created on first startup if no admin exists) ----
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=ChangeMe123!
