# ============================================================
# Gitignore raiz del monorepo (backend/ y frontend/ tienen ademas
# su propio .gitignore mas especifico). Este actua como red de
# seguridad general para todo el repositorio.
# ============================================================

# ---- Variables de entorno / secretos (nunca versionar) ----
.env
.env.local
.env.*.local
.env.development
.env.production
!.env.example

# ---- Sistema operativo ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ---- Editores / IDEs ----
.idea/
.vscode/
*.iml
.vs/
*.swp
*.swo
*~

# ---- Logs y archivos temporales ----
*.log
logs/
*.tmp
*.temp

# ---- Red de seguridad por si se corre algo desde la raiz ----
node_modules/
dist/
build/
target/

# ---- Archivos comprimidos accidentales ----
*.zip
